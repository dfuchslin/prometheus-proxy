{
  "name": "prometheus-proxy",
  "version": "0.0.1",
  "description": "prometheus proxy",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "kubectl apply -f prometheus-proxy.yaml"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/log": "^6.3.3",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/prometheus": "^1.0.3",
    "env-var": "^7.5.0",
    "hono": "^4.13.13",
    "log": "^6.3.2",
    "log-node": "^8.0.3",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=26"
  }
}
